#!/bin/bash
# Test battery runner for the prognostic-carbon single-column driver.
# Runs site_driver.jl once per row of test_sites.csv, NPAR sites concurrently on
# one CPU node. Each column is ~1 core and ~2-3 GB, and the sites are fully
# independent, so a 20-site battery costs a few core-hours.
#
# Output goes to scratch, never the repo:
#   /glade/derecho/scratch/arenchon/claude/prognostic_carbon/battery_<jobid>/
#
# qsub environment transfer (-v / -V) is disabled on Derecho, so configuration
# is read from a sidecar file rather than the submit environment. The job name
# selects the file, so independent batteries can run concurrently without
# fighting over one shared conf:
#   $PC_SCRATCH/battery_<jobname>.conf   preferred
#   $PC_SCRATCH/battery.conf             fallback
# Submit:  qsub -N pc_batt_pres experiments/.../run_battery.pbs
# With no conf file the full 20-site battery runs with prescribed MODIS LAI.
#PBS -N pc_battery
#PBS -A UCIT0011
#PBS -q develop
#PBS -l walltime=05:00:00
#PBS -l select=1:ncpus=16:mem=160GB
#PBS -j oe
#PBS -m n
#PBS -o /glade/derecho/scratch/arenchon/claude/prognostic_carbon/
export MODULEPATH="/glade/campaign/univ/ucit0011/ClimaModules-Derecho:$MODULEPATH"
module load climacommon
export HDF5_USE_FILE_LOCKING=FALSE   # intermittent HDF5 file-locking errors on Derecho Lustre
REPO=/glade/u/home/arenchon/ClimaLand.jl
JULIA=/glade/campaign/univ/ucit0011/software/julia/julia-1.12.4/bin/julia
HARNESS=$REPO/experiments/integrated/prognostic_carbon/harness
CSV=$HARNESS/test_sites.csv
DRIVER=$HARNESS/site_driver.jl
PC_SCRATCH=/glade/derecho/scratch/arenchon/claude/prognostic_carbon
RUNROOT=$PC_SCRATCH/battery_${PBS_JOBNAME:-run}_${PBS_JOBID:-local}
mkdir -p "$RUNROOT"; cd "$RUNROOT"

CONF=$PC_SCRATCH/battery_${PBS_JOBNAME}.conf
[[ -f "$CONF" ]] || CONF=$PC_SCRATCH/battery.conf
[[ -f "$CONF" ]] && { echo "CONF $CONF"; source "$CONF"; } || echo "CONF none (defaults)"

START="${START:-2000-09-01}"
STOP="${STOP:-2002-09-01}"
SUBSET="${SUBSET:-}"
LAI_MODE="${LAI_MODE:-prescribed}"   # prescribed MODIS LAI for stages 1-3; prognostic Zhou from stage 4
SPINUP_YEARS="${SPINUP_YEARS:-1}"    # years excluded from the reported means
DT="${DT:-450.0}"
CARBON="${CARBON:-0}"           # 1 = wrap the LAI model in the prognostic carbon pools
CARBON_RA="${CARBON_RA:-0}"      # 1 = take Ra from the pools instead of the JULES term (needs CARBON=1)
# Diagnostic: seed the pools rather than starting empty (kg C m^-2). Empty = start empty.
POOL_INIT_SUGAR="${POOL_INIT_SUGAR:-}"; POOL_INIT_LEAF="${POOL_INIT_LEAF:-}"
POOL_INIT_STEM="${POOL_INIT_STEM:-}"; POOL_INIT_ROOT="${POOL_INIT_ROOT:-}"
POOL_INIT_DEFICIT="${POOL_INIT_DEFICIT:-}"
# Parameter overrides; empty = branch default (see site_driver.jl).
OPT_Z="${OPT_Z:-}"; OPT_Z_C4="${OPT_Z_C4:-}"
OPT_SIGMA="${OPT_SIGMA:-}"; OPT_SIGMA_C4="${OPT_SIGMA_C4:-}"
OPT_ALPHA="${OPT_ALPHA:-}"; F0="${F0:-}"; Z_A0="${Z_A0:-}"
ONLINE_C3C4="${ONLINE_C3C4:-}"

# NPAR sites run concurrently. Capped to the allocated ncpus (NOT nproc, which
# can report the node's physical cores from inside a cpuset). Keep the PBS
# select mem >= NPAR*3 GB.
NPAR="${NPAR:-8}"
echo "BATTERY start=$START stop=$STOP subset='${SUBSET:-ALL}' lai_mode=$LAI_MODE carbon=$CARBON pool_Ra=$CARBON_RA spinup_years=$SPINUP_YEARS npar=$NPAR runroot=$RUNROOT"

# Precompile once up front so the concurrent workers hit a warm cache.
"$JULIA" --project="$REPO/.buildkite" -e 'using Pkg; Pkg.instantiate()'
"$JULIA" --project="$REPO/.buildkite" -e 'using ClimaLand' >/dev/null 2>&1 || true

# SEED_FROM_TSV points at harness/equilibrium_pools.tsv and seeds each site with
# its own offline equilibrium instead of one global value. The offline-vs-coupled
# drift check needs this: a coupled run started at the offline steady state
# should stay there, and a per-site seed is the only way to ask that question at
# more than one site per job.
SEED_FROM_TSV="${SEED_FROM_TSV:-}"

seed_for() {
    local name="$1" col="$2"
    [[ -n "$SEED_FROM_TSV" && -f "$SEED_FROM_TSV" ]] || return 0
    awk -F'\t' -v s="$name" -v c="$col" '$1==s{print $c}' "$SEED_FROM_TSV"
}

run_site() {
    local lon="$1" lat="$2" name="$3"
    local SITEDIR="$RUNROOT/$name"
    mkdir -p "$SITEDIR"
    if [[ -n "$SEED_FROM_TSV" ]]; then
        POOL_INIT_SUGAR="$(seed_for "$name" 3)"; POOL_INIT_LEAF="$(seed_for "$name" 4)"
        POOL_INIT_STEM="$(seed_for "$name" 5)";  POOL_INIT_ROOT="$(seed_for "$name" 6)"
        # Column 7 is D_annual, absent from older TSVs; empty just means unseeded.
        POOL_INIT_DEFICIT="$(seed_for "$name" 7)"
        echo "SEED $name sugar=$POOL_INIT_SUGAR leaf=$POOL_INIT_LEAF stem=$POOL_INIT_STEM root=$POOL_INIT_ROOT deficit=$POOL_INIT_DEFICIT"
    fi
    if START="$START" STOP="$STOP" DT="$DT" SITE_LON="$lon" SITE_LAT="$lat" \
        SITE_NAME="$name" SITE_OUTDIR="$SITEDIR/out" LAI_MODE="$LAI_MODE" \
        CARBON="$CARBON" CARBON_RA="$CARBON_RA" \
        POOL_INIT_SUGAR="$POOL_INIT_SUGAR" POOL_INIT_LEAF="$POOL_INIT_LEAF" \
        POOL_INIT_STEM="$POOL_INIT_STEM" POOL_INIT_ROOT="$POOL_INIT_ROOT" \
        POOL_INIT_DEFICIT="$POOL_INIT_DEFICIT" \
        SPINUP_YEARS="$SPINUP_YEARS" \
        OPT_Z="$OPT_Z" OPT_Z_C4="$OPT_Z_C4" OPT_SIGMA="$OPT_SIGMA" \
        OPT_SIGMA_C4="$OPT_SIGMA_C4" OPT_ALPHA="$OPT_ALPHA" F0="$F0" \
        Z_A0="$Z_A0" ONLINE_C3C4="$ONLINE_C3C4" \
        "$JULIA" --project="$REPO/.buildkite" "$DRIVER" \
        >"$SITEDIR/$name.log" 2>&1; then
        echo "SITE_OK $name"; echo PASS >"$SITEDIR/.status"
    else
        echo "SITE_FAIL $name (see $SITEDIR/$name.log)"; echo FAIL >"$SITEDIR/.status"
    fi
}

while IFS=, read -r lon lat biome name; do
    [[ "$lon" =~ ^# ]] && continue
    [[ "$lon" == "lon" ]] && continue
    [[ -z "$lon" ]] && continue
    if [[ -n "$SUBSET" ]]; then
        case ",$SUBSET," in *",$name,"*) ;; *) continue ;; esac
    fi
    while (( $(jobs -rp | wc -l) >= NPAR )); do wait -n; done
    echo "=== LAUNCH $name ($lon,$lat) $biome ==="
    run_site "$lon" "$lat" "$name" &
done <"$CSV"
wait
npass=$(grep -rl '^PASS$' "$RUNROOT"/*/.status 2>/dev/null | wc -l)
nfail=$(grep -rl '^FAIL$' "$RUNROOT"/*/.status 2>/dev/null | wc -l)

# Baseline table: one row per site, tab-separated, for pasting into STATE.md.
SUMMARY="$RUNROOT/baseline_summary.tsv"
{
    printf 'site\tbiome\tGPP_gC_m2_day\tRa_gC_m2_day\tRh_gC_m2_day\tLAI\tTair_K\tSWC\tC_sugar\tC_leaf\tC_stem\tC_root\tcVeg\tsigma_l_implied\tcSoil\tcSoil_init\tcSoil_dfrac\n'
    while IFS=, read -r lon lat biome name; do
        [[ "$lon" =~ ^# || "$lon" == "lon" || -z "$lon" ]] && continue
        m="$RUNROOT/$name/out/carbon_metrics.txt"
        [[ -f "$m" ]] || continue
        get() { awk -v k="$1" '$1==k{print $2}' "$m"; }
        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$name" "$biome" \
            "$(get GPP_gC_m2_day)" "$(get Ra_gC_m2_day)" "$(get Rh_gC_m2_day)" \
            "$(get LAI_m2_m2)" "$(get Tair_K)" "$(get SWC_m3_m3)" \
            "$(get C_sugar_kgC_m2)" "$(get C_leaf_kgC_m2)" "$(get C_stem_kgC_m2)" \
            "$(get C_root_kgC_m2)" "$(get cVeg_kgC_m2)" "$(get sigma_l_implied_kgC_m2leaf)" \
            "$(get cSoil_kgC_m2)" "$(get cSoil_initial_kgC_m2)" "$(get cSoil_frac_change)"
    done <"$CSV"
} >"$SUMMARY"
echo "--- baseline_summary.tsv ---"; cat "$SUMMARY"
echo "BATTERY_DONE pass=$npass fail=$nfail summary=$SUMMARY"
